{
  "id": "diners-socios",
  "name": "Perfil de socio Diners",
  "version": 2,
  "description": "Perfil maestro de socios para identificación y personalización de la atención.",
  "allowProfileCreation": true,
  "updatedAt": "2026-10-28T00:00:00Z",
  "updatedBy": "terraform",
  "fields": [
    { "sourceColumn": "DNI",                  "destinationId": "account-number",      "contentType": "STRING",       "required": true,  "identifier": "PROFILE_UNIQUE", "validation": "8 dígitos; obligatorio y único" },
    { "sourceColumn": "NOMBRE_SOCIO",         "destinationId": "first-name",          "contentType": "STRING",       "required": true,  "identifier": "NONE",           "validation": "Texto; obligatorio" },
    { "sourceColumn": "TELEFONO_1",           "destinationId": "mobile-phone",        "contentType": "PHONE_NUMBER", "required": false, "identifier": "PROFILE",        "validation": "11 dígitos con prefijo 51; vacío genera advertencia. Clave de búsqueda en voz" },
    { "sourceColumn": "correo",               "destinationId": "personal-email",      "contentType": "EMAIL_ADDRESS","required": true,  "identifier": "NONE",           "validation": "Dirección de correo válida" },
    { "sourceColumn": "SEGMENTO_VALOR",       "destinationId": "segmento-valor",      "contentType": "STRING",       "required": false, "identifier": "NONE",           "validation": "1, 2 o 3; vacío genera advertencia" },
    { "sourceColumn": "MARCA_RETENER",        "destinationId": "marca-retener",       "contentType": "STRING",       "required": true,  "identifier": "NONE",           "validation": "1 o 2; obligatorio" },
    { "sourceColumn": "tiene_oferta",         "destinationId": "tiene-oferta",        "contentType": "STRING",       "required": true,  "identifier": "NONE",           "validation": "S o N; obligatorio" },
    { "sourceColumn": "tea",                  "destinationId": "tea",                 "contentType": "NUMBER",       "required": false, "identifier": "NONE",           "validation": "Decimal entre 0 y 200" },
    { "sourceColumn": "fecha_afiliacion",     "destinationId": "fecha-afiliacion",    "contentType": "STRING",       "required": true,  "identifier": "NONE",           "validation": "AAAA-MM-DD; no puede ser futura" },
    { "sourceColumn": "tipo_producto",        "destinationId": "tipo-producto",       "contentType": "STRING",       "required": true,  "identifier": "NONE",           "validation": "Free, Hiraoka, Club, Miles, Special Edition, Carte Blanche" },
    { "sourceColumn": "fecha_nacimiento",     "destinationId": "birth-date",          "contentType": "STRING",       "required": false, "identifier": "NONE",           "validation": "AAAA-MM-DD; no puede ser futura. Saludo de cumpleaños" },
    { "sourceColumn": "SCORE_OFERTA",         "destinationId": "score-oferta",        "contentType": "STRING",       "required": false, "identifier": "NONE",           "validation": "A, B, C, D o E; vacío genera advertencia. Decide canal de llamada de venta" },
    { "sourceColumn": "LINEA_CREDITO",        "destinationId": "linea-credito",       "contentType": "STRING",       "required": false, "identifier": "NONE",           "validation": "Texto libre (ej. S/ 12.000, US$ 5.000). Constancia de socio (D15)" },
    { "sourceColumn": "CALLCENTER_COBRANZA", "destinationId": "callcenter-cobranza", "contentType": "STRING",       "required": false, "identifier": "NONE",           "validation": "GEINCOS, XLCORP o vacío si no aplica. Base D13" },
    { "sourceColumn": "CENTRAL_COBRANZA",    "destinationId": "central-cobranza",    "contentType": "STRING",       "required": false, "identifier": "NONE",           "validation": "Teléfono de la central de cobranza. El agente lo da al socio en N1" },
    { "sourceColumn": "REFINANCIADO",        "destinationId": "refinanciado",         "contentType": "STRING",       "required": false, "identifier": "NONE",           "validation": "S o N. Cambia la respuesta del flujo N1" }
  ]
}
